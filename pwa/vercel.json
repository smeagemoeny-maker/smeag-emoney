{
  "framework": null,
  "buildCommand": "node scripts/sync-api.mjs",
  "installCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__path=:path*"
    }
  ],
  "redirects": [
    {
      "source": "/api/index.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/api/_lib/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/scripts/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
