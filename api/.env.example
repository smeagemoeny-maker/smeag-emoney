PORT=8787
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:4173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=change_me
DB_PASSWORD=change_me
DB_NAME=smeagemoney

SESSION_SECRET=change_me

# Use local DBSQL dumps instead of the live MySQL server.
USE_MOCK_DB=false

# DB_BACKEND=supabase (default) | mysql
DB_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=change_me

# SME REFUND tab (smeadmin.com refunds -> e-money). Use a dedicated read-only smeadmin account, not an admin's.
SMEADMIN_BASE_URL=http://www.smeadmin.com/gnuboard4
SMEADMIN_LOGIN_ID=change_me
SMEADMIN_PASSWORD=change_me
# 32+ random characters. Never change it after the first sync: passport hashes would no longer match.
PASSPORT_HMAC_SECRET=change_me
# Allowed |RMB x rate - amount| in pesos (default 2), item name of the refund line, sync window in days
SMEADMIN_TOLERANCE_PHP=2
SMEADMIN_REFUND_ITEM=Student allowance
SMEADMIN_SYNC_DAYS=45
